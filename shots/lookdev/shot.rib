## Look development for the museum shot under the ray tracer: a translucent stand-in for the case, whose
## glass blocks the ray tracer's shadow rays,
## point and distant lights in place of the area lights it ignores, and the lightbox faked as a
## constant white plate with point lights at its surface. RENDERER=gmanraytracer make shot=lookdev
Format 1024 768 1
PixelSamples 3 3
Option "pathtracer" "integer samples" [256]
Projection "perspective" "fov" [50]
Clipping 0.5 500
Imager "background" "background" [0.045 0.045 0.05]
Translate 0 -2.6 11
Rotate -12 1 0 0
WorldBegin
LightSource "pointlight" 50 "from" [0 12 -3] "intensity" [90] "lightcolor" [1 0.93 0.82]
LightSource "distantlight" 51 "from" [-1 1.5 -2] "to" [0 0 0] "intensity" [0.5]
AttributeBegin
AreaLightSource "arealight" 1 "intensity" [30] "lightcolor" [1 0.93 0.82]
Translate 0 16 -4
Rotate -90 1 0 0
Disk 0 2.5 360
AttributeEnd
ReadArchive "../../assets/museum/plinth.rib"
ReadArchive "../../assets/museum/border.rib"
ReadArchive "case.rib"
AttributeBegin
LightSource "ambientlight" 60 "intensity" [1]
Surface "paintedplastic" "Ka" [1] "Kd" [0] "Ks" [0]
Color [1 1 1]
Polygon "P" [-4.2 0 -3.2  4.2 0 -3.2  4.2 0 3.2  -4.2 0 3.2]
AttributeEnd
LightSource "pointlight" 61 "from" [3.6 0.05 0] "intensity" [2.5] "lightcolor" [0.96 0.98 1]
LightSource "pointlight" 62 "from" [-3.6 0.05 0] "intensity" [2.5] "lightcolor" [0.96 0.98 1]
LightSource "pointlight" 63 "from" [0 0.05 -2.9] "intensity" [2.5] "lightcolor" [0.96 0.98 1]
LightSource "pointlight" 64 "from" [0 0.05 2.9] "intensity" [2.5] "lightcolor" [0.96 0.98 1]
AttributeBegin
Rotate 180 0 1 0
ReadArchive "../../assets/teapot/teapot_tall.rib"
AttributeEnd
WorldEnd
